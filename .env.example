# 複製成 .env 並填入自己的值；.env 已列在 .gitignore，不會被提交

# Flask session 金鑰（留空則每次啟動隨機產生）
SECRET_KEY=

# MySQL 連線：使用者帳號資料庫與防火牆日誌資料庫
DATABASE_URI=mysql+pymysql://root:your_password@localhost/web
FIREWALL_LOGS_URI=mysql+pymysql://root:your_password@localhost/firewall_logs

# 寄送 OTP 用的信箱（Gmail 需使用應用程式密碼）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
